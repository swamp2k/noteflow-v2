<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2B2B49" />
            <stroke android:width="1dp" android:color="@color/noteflow_accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/noteflow_surface" />
            <stroke android:width="1dp" android:color="@color/noteflow_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
